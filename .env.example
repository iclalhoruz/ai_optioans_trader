# Copy this to .env and fill in real values. Nothing here is loaded with
# secrets by default - the whole system runs in mock mode without any of
# these set, this file is just here so the real Alpaca wiring is a drop-in
# once the MCP tools have actually been looked at.

# --- Alpaca (paper trading by default) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Service URLs (used by workflow/pipeline.py) ---
# Defaults already point at the ports docker-compose maps to localhost, only
# override these if you're running the pipeline from inside the compose
# network (then use the service names, e.g. http://broker-gateway:8001).
BROKER_GATEWAY_URL=http://localhost:8001
AI_STRATEGY_URL=http://localhost:8002
CHAOS_SANDBOX_URL=http://localhost:8003
RISK_ENGINE_URL=http://localhost:8004

# --- Redis (pipeline run state) ---
REDIS_URL=redis://localhost:6379/0

# --- Featherless AI (ai-strategy's LLM calls) ---
# OpenAI-compatible - point the `openai` Python client's base_url here and
# use FEATHERLESS_API_KEY as the api_key, no separate SDK needed.
# Pick a model at https://featherless.ai/models (check it isn't gated - if
# it is, open the model's page and click "Unlock Model" first).
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=

# --- Risk engine hard-veto thresholds ---
MAX_ALLOCATION_PCT=0.05
MAX_PORTFOLIO_DELTA=100
MIN_CONVICTION_SCORE=0.4
# Fallback only - once broker-gateway's /account endpoint is live, risk-engine
# should call that for the real figure instead of trusting this.
MOCK_PORTFOLIO_VALUE=100000

# --- Pipeline behavior ---
STEP_TIMEOUT_SECONDS=10
STEP_MAX_RETRIES=3
HITL_ENABLED=false
HITL_NOTIONAL_THRESHOLD=10000

# --- Autonomous scheduler (workflow/scheduler.py) ---
# The "autonomous" part of the pipeline - loops over this watchlist and
# triggers a run per ticker on an interval, no human involved.
# Deliberately a mix of price points: AAPL/TSLA/NVDA/SPY/MSFT are all
# $200-800+ stocks - checked live with real Black-Scholes math that a
# single deep-ITM contract on any of them can cost $5,000-10,000+, over
# risk-engine's 5% MAX_ALLOCATION_PCT cap on a $100k account regardless of
# ITM depth or expiry (see CLAUDE.md's "Trading-system completeness pass").
# The rest (F/INTC/BAC/T/PFE/KO/DIS/PYPL/SOFI/UBER) are lower-priced,
# liquid, real optionable names added specifically so some proposals are
# actually affordable enough to reach execution, not just the pipeline
# running architecturally correctly end-to-end with nothing ever filling.
WATCHLIST_TICKERS=AAPL,TSLA,NVDA,SPY,MSFT,F,INTC,BAC,T,PFE,KO,DIS,PYPL,SOFI,UBER
SCHEDULER_INTERVAL_MINUTES=15

# --- broker-gateway CORS ---
# Comma-separated origins allowed to call broker-gateway directly from a
# browser. Only matters once the frontend flips VITE_USE_MOCKS=false - the
# scheduler/pipeline talk to broker-gateway server-to-server and aren't
# subject to CORS at all.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Position exit rules (services/broker-gateway/position_manager.py) ---
# Deterministic, no LLM - the counterpart to ai-strategy's entry decision.
# workflow/scheduler.py triggers a check every cycle via POST /positions/manage.
TAKE_PROFIT_PCT=0.25
STOP_LOSS_PCT=0.20
MIN_DAYS_BEFORE_CLOSE=14

# --- ai-strategy position sizing ---
# Fraction of portfolio_value to risk per trade at full (1.0) conviction -
# scaled down by the model's actual conviction_score. Kept well under
# risk-engine's MAX_ALLOCATION_PCT (5%) so sizing isn't the reason a
# reasonable proposal gets vetoed.
TARGET_ALLOCATION_PCT=0.03
MAX_CONTRACTS_PER_TRADE=5
