# Copy to .env.local to override. Everything works with mocks and no config
# at all - these only matter once a real backend endpoint exists.

# Base URL of the read API exposing pipeline/portfolio data (doesn't exist
# yet - see root CLAUDE.md). Only used when VITE_USE_MOCKS=false.
VITE_API_BASE_URL=

# true (default) = every screen reads from src/api/mocks/. Set to false once
# VITE_API_BASE_URL points at something real.
VITE_USE_MOCKS=true
