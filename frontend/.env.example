# Copy to .env.local to override. Everything works with mocks and no config
# at all, which is why that stays the default here - only flip these once
# the real backend stack (docker compose up, or broker-gateway run
# manually) is actually running on the URL below.

# Base URL of the read API exposing pipeline/portfolio data -
# services/broker-gateway/runs.py (GET /runs/active|recent|{id}, POST
# /runs), wired up and verified live end-to-end - see root CLAUDE.md's
# frontend section. Only used when VITE_USE_MOCKS=false.
VITE_API_BASE_URL=http://localhost:8001

# true (default) = every screen reads from src/api/mocks/. Set to false once
# VITE_API_BASE_URL points at something real (e.g. the real stack above).
VITE_USE_MOCKS=false
